# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# PayPal (sandbox app credentials from developer.paypal.com while testing)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Apps Script guest contract system (Bookings sheet + contract PDFs)
APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
APPS_SCRIPT_API_KEY=your_website_api_key_here

# WhatsApp (replace with real number in international format, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567

# Contact email
NEXT_PUBLIC_CONTACT_EMAIL=hello@menacollection.com
